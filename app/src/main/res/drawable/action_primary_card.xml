<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#DDE9DF" />
            <stroke android:width="1dp" android:color="#CEDDCE" />
            <corners android:radius="16dp" />
            <padding android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/green_soft" />
            <stroke android:width="1dp" android:color="#D6E3D7" />
            <corners android:radius="16dp" />
            <padding android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp" />
        </shape>
    </item>
</selector>
