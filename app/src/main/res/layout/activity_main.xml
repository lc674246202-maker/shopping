<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pageRecognize"
            layout="@layout/view_recognize" />

        <include
            android:id="@+id/pageRecords"
            layout="@layout/view_records"
            android:visibility="gone" />

        <include
            android:id="@+id/pageSettings"
            layout="@layout/view_settings"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/surface"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/navRecognize"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nav_item_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_recognize"
            android:textColor="@color/nav_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navRecords"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/nav_item_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_records"
            android:textColor="@color/nav_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nav_item_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_settings"
            android:textColor="@color/nav_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
