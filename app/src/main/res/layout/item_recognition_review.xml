<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_background"
    android:orientation="vertical">

    <TextView
        android:id="@+id/itemTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/itemRecognitionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/green"
        android:textSize="12sp" />

    <TextView style="@style/FormLabel" android:layout_marginTop="14dp" android:text="商品名称" />
    <AutoCompleteTextView
        android:id="@+id/itemProductName"
        style="@style/FormInput"
        android:completionThreshold="1"
        android:hint="请输入商品名称"
        android:inputType="text" />

    <TextView style="@style/FormLabel" android:layout_marginTop="12dp" android:text="商品型号（可留空）" />
    <EditText
        android:id="@+id/itemRawSpecification"
        style="@style/FormInput"
        android:hint="未识别时可稍后手填"
        android:inputType="text" />

    <TextView style="@style/FormLabel" android:layout_marginTop="12dp" android:text="购买数量" />
    <EditText
        android:id="@+id/itemPurchaseQuantity"
        style="@style/FormInput"
        android:hint="例如：2"
        android:inputType="numberDecimal" />

    <TextView style="@style/FormLabel" android:layout_marginTop="12dp" android:text="商品规格 / 每份件数（可留空）" />
    <EditText
        android:id="@+id/itemInnerCount"
        style="@style/FormInput"
        android:hint="例如一箱24盒，填写24"
        android:inputType="numberDecimal" />

    <TextView style="@style/FormLabel" android:layout_marginTop="12dp" android:text="商品实付金额（元）" />
    <EditText
        android:id="@+id/itemPaidAmount"
        style="@style/FormInput"
        android:hint="@string/line_paid_label"
        android:inputType="numberDecimal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/action_primary_card"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="商品单价 · 实付金额 ÷ 购买数量"
            android:textColor="@color/muted"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/itemPackagePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="商品件价 · 商品单价 ÷ 件数"
            android:textColor="@color/muted"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/itemStandardPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/green_dark"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
