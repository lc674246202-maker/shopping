<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="24dp"
        android:paddingEnd="18dp"
        android:paddingBottom="26dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_background"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_ai_title"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/apiKeyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_ai_hint"
                    android:textColor="@color/green"
                    android:textSize="12sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/apiKeyInput"
                style="@style/FormInput"
                android:layout_marginTop="12dp"
                android:hint="粘贴个人 DeepSeek API Key"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveApiKeyButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/primary_button"
                    android:text="保存"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white" />
                <Button
                    android:id="@+id/testApiKeyButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/secondary_button"
                    android:text="测试"
                    android:textAllCaps="false"
                    android:textColor="@color/green" />
                <Button
                    android:id="@+id/clearApiKeyButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/secondary_button"
                    android:text="清除"
                    android:textAllCaps="false"
                    android:textColor="@color/green" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="2dp"
                android:text="Key 经 Android Keystore 加密保存在本机，不写入导出文件。"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="数据导出与迁移"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/exportZipButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/settings_row_background"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="12dp"
                android:text="导出备份 ZIP  ›"
                android:textAllCaps="false"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/importZipButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/settings_row_background"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="12dp"
                android:text="导入备份 ZIP  ›"
                android:textAllCaps="false"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/exportCsvButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/settings_row_background"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="12dp"
                android:text="导出购物记录 CSV  ›"
                android:textAllCaps="false"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/lastExportStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="上次完整导出：从未"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/importPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/action_primary_card"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="导入预览"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/importPreviewSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />
            <CheckBox
                android:id="@+id/importConfirmCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="我已确认迁移包内容；首版仅支持恢复到空数据库" />
            <Button
                android:id="@+id/restoreImportButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/primary_button"
                android:enabled="false"
                android:text="开始恢复"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="数据统计"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/storageSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/settings_storage_loading"
                android:textColor="@color/muted"
                android:textSize="13sp" />
            <Button
                android:id="@+id/clearAiTasksButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/settings_row_background"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="12dp"
                android:text="清理已结束的识别任务"
                android:textAllCaps="false"
                android:textColor="@color/ink" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="关于"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_version"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/settings_privacy"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
